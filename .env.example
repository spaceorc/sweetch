# sweetch LLM credentials — copy to .env and fill in.
# .env is gitignored; never commit real keys.

# --- ANNA LLM proxy (preferred) — plain HTTP, no key; needs ANNA network/VPN ---
SWEETCH_PROXY_URL=https://llm-proxy-stage2.k2.anna.money

# --- Azure AI Foundry (Anthropic models) — preferred ---
# The Foundry resource name and its API key.
SWEETCH_AZURE_RESOURCE=your-foundry-resource-name
SWEETCH_AZURE_API_KEY=your-azure-api-key

# --- Anthropic via Google Vertex — fallback (not yet wired up) ---
SWEETCH_VERTEX_PROJECT=your-gcp-project
SWEETCH_VERTEX_LOCATION=europe-west1
SWEETCH_VERTEX_CREDENTIALS=base64-encoded-service-account-json
